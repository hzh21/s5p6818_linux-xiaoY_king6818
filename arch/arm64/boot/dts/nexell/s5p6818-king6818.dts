/dts-v1/;
#include "s5p6818-king6818-common.dtsi"

/ {
	model = "RongPin king6818";
	compatible = "RongPin,king6818", "nexell,s5p6818";
};

&mach {
	hwrev = <0>;
	model = "king6818";
};

&dw_mmc_1 {
	status = "okay";
};

&simple_card {
	simple-audio-card,dai-link@0 {
		hp-det-gpio = <&gpio_b 27 0>;
	};
};

&spi_0 {
	/delete-node/ fbtft@0;
};
/* 2. 修正硬件 I2C0 - 先写属性，再处理内部节点 */
&i2c_0 {
	/* 属性在前 */
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins_rongpin>; 
	status = "okay";

	/* 如果 i2c_0 下有子节点，它们会自动排在后面 */
};

/* 3. 彻底重写模拟总线 3 - 严格遵守属性优先原则 */
&i2c3_gpio {
	/* 首先通过删除指令清理原有结构 */
	/delete-node/ spu1705@2d;
	/delete-node/ axp228@34;

	/* 所有的属性（Properties）必须放在这里 */
	gpios = <&gpio_d 1 0    /* SDA: GPIOD1 */
	         &gpio_d 0 0>;  /* SCL: GPIOD0 */
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins_rongpin>;
	i2c-gpio,delay-us = <5>;
	status = "okay";

	/* 所有的子节点（Subnodes）必须放在属性之后 */
	axp228: pmic@34 {
		compatible = "x-powers,axp228";
		reg = <0x34>;
		interrupt-parent = <&alive_0>;
		interrupts = <4 8>; /* Alive-4, 低电平触发 */
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_irq_pin>;

		regulators {
			/* DCDC2: CPU 核心电压 */
			vdd_arm: dcdc2 {
				regulator-name = "vdd_arm";
				regulator-min-microvolt = <1100000>; /* 荣品 1.1V */
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			/* DCDC5: 内存电压 */
			vcc_ddr: dcdc5 {
				regulator-name = "vcc_ddr";
				regulator-min-microvolt = <1500000>; /* 荣品 1.5V */
				regulator-max-microvolt = <1500000>;
				regulator-always-on;
				regulator-boot-on;
			};

			/* ELDO2: Wi-Fi 模块供电 */
			vcc_wifi: eldo2 {
				regulator-name = "vcc_wifi";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};

			/* ALDO2: 音频芯片模拟供电 */
			vcc_audio: aldo2 {
				regulator-name = "vcc_audio";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};
		};
	};
};
