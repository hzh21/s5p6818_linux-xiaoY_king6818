/dts-v1/;
#include "s5p6818-king6818-common.dtsi"

/ {
	model = "RongPin king6818";
	compatible = "RongPin,king6818", "nexell,s5p6818";
};

&mach {
	hwrev = <0>;
	model = "king6818";
};

&dw_mmc_1 {
	status = "okay";
};

&simple_card {
	simple-audio-card,dai-link@0 {
		hp-det-gpio = <&gpio_b 27 0>;
	};
};

&spi_0 {
	/delete-node/ fbtft@0;
};
/* --- 彻底清理引脚占用，解锁 D2/D3 --- */
&i2c_0 { 
    status = "disabled"; 
    /delete-property/ pinctrl-0; 
    /delete-property/ pinctrl-names;
};

&i2c_1 { status = "disabled"; };
&i2c_2 { status = "disabled"; };

/* 彻底删除引脚标签定义，从源头切断所有潜在引用 */
/delete-node/ &i2c0_pin;
/delete-node/ &i2c1_pin;
/delete-node/ &i2c2_pin;
