/dts-v1/;
#include "s5p6818-king6818-common.dtsi"

/ {
	model = "RongPin king6818";
	compatible = "RongPin,king6818", "nexell,s5p6818";
};

&mach {
	hwrev = <0>;
	model = "king6818";
};

&dw_mmc_1 {
	status = "okay";
};

&simple_card {
	simple-audio-card,dai-link@0 {
		hp-det-gpio = <&gpio_b 27 0>;
	};
};

&spi_0 {
	/delete-node/ fbtft@0;
};
/* 禁用友善之臂默认的模拟总线 */
/delete-node/ &i2c3_gpio;

&i2c_0 {
    status = "okay";
    clock-frequency = <400000>;

    axp228: pmic@34 {
        compatible = "x-powers,axp228";
        reg = <0x34>;
        interrupt-parent = <&gpio_b>;
        interrupts = <28 IRQ_TYPE_LEVEL_LOW>;

        regulators {
            /* CPU 核心电压：解决 DVFS 报错 */
            vdd_arm_axp: dcdc2 {
                regulator-name = "vdd_arm";
                regulator-min-microvolt = <1000000>;
                regulator-max-microvolt = <1300000>;
                regulator-boot-on;
                regulator-always-on;
            };

            /* 内存电压：确保 2GB 稳定运行 */
            vcc_ddr: dcdc5 {
                regulator-name = "vcc_ddr";
                regulator-min-microvolt = <1500000>; /* 1.5V */
                regulator-max-microvolt = <1500000>;
                regulator-boot-on;
                regulator-always-on;
            };

            /* Wi-Fi 电源：开启硬件供电 */
            vcc_wifi: eldo2 {
                regulator-name = "vcc_wifi";
                regulator-min-microvolt = <3300000>;
                regulator-max-microvolt = <3300000>;
                regulator-boot-on;
            };

            /* 音频供电：修复 ES8316 */
            vcc_audio: aldo2 {
                regulator-name = "vcc_audio";
                regulator-min-microvolt = <1800000>;
                regulator-max-microvolt = <1800000>;
                regulator-boot-on;
            };
        };
    };
};
