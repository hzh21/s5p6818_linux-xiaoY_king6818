/dts-v1/;
#include "s5p6818-king6818-common.dtsi"

/ {
	model = "RongPin king6818";
	compatible = "RongPin,king6818", "nexell,s5p6818";
};

&mach {
	hwrev = <0>;
	model = "king6818";
};

&dw_mmc_1 {
	status = "okay";
};

&simple_card {
	simple-audio-card,dai-link@0 {
		hp-det-gpio = <&gpio_b 27 0>;
	};
};

&spi_0 {
	/delete-node/ fbtft@0;
};
/* 1. 禁用原有的模拟总线 */
/delete-node/ &i2c3_gpio;

/* 2. 在硬件 I2C0 下重建 PMIC 并恢复 Labels */
&i2c_0 {
	status = "okay";
	samsung,i2c-max-bus-freq = <400000>;

	axp22x: pmic@34 {
		compatible = "x-powers,axp228";
		reg = <0x34>;
		interrupt-parent = <&gpio_b>;
		interrupts = <28 8>;

		regulators {
			/* 恢复 VCC_DCDC1 标签 */
			VCC_DCDC1: axp22_dcdc1 {
				regulator-name = "axp228_3p3_sys";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			/* 恢复 VCC1P1_ARM_PMIC 标签，这是 CPU 调频的关键 */
			VCC1P1_ARM_PMIC: axp22_dcdc2 {
				regulator-name = "vdd_arm";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-boot-on;
			};

			/* DCDC5: 内存电压 */
			vcc_ddr: axp22_dcdc5 {
				regulator-name = "vcc_ddr";
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <1500000>;
				regulator-always-on;
				regulator-boot-on;
			};

			/* 其他 LDO 保持现状，根据需要添加 Label */
			eldo2 {
				regulator-name = "vcc_wifi";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};
		};
	};
};

/* 3. 修复 DVFS (CPU调频) 节点的引用错误 */
&dvfs {
	/* 荣品板子没有 SPU1705 芯片，所以我们要把它的电源引用指向 AXP228 */
	vdd_arm_spu-supply = <&VCC1P1_ARM_PMIC>;
	vdd_arm_axp-supply = <&VCC1P1_ARM_PMIC>;
};
